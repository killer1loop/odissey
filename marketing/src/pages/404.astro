---
import Brand from "../components/Brand.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Odissey"
  description="The requested Odissey page could not be found."
>
  <main id="main-content" class="not-found">
    <Brand />
    <p class="eyebrow">404 · Signal lost</p>
    <h1>This channel is off air.</h1>
    <p>The page you were looking for is not part of tonight’s lineup.</p>
    <a class="button button--primary" href="/">
      Return home
      <Icon name="arrow" size={17} />
    </a>
  </main>
</BaseLayout>
