---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const prototypePath = resolve(process.cwd(), "../previews/aurora.html");

const replaceOnce = (
  value: string,
  search: string,
  replacement: string,
  label: string,
): string => {
  const occurrences = value.split(search).length - 1;

  if (occurrences !== 1) {
    throw new Error(
      `Expected exactly one ${label} block in Aurora, found ${occurrences}.`,
    );
  }

  return value.replace(search, replacement);
};

const productionHead = `<meta name="robots" content="index, follow">
<meta name="theme-color" content="#05070c">
<meta name="color-scheme" content="dark">
<meta name="description" content="A fast, private media home for movies, series, music and live TV. Self-hosted for free, with hosted plans coming soon from $10/month.">
<link rel="canonical" href="https://odissey.app/">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preload" href="/odissey-orbit.webp" as="image" type="image/webp">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Odissey">
<meta property="og:title" content="Odissey — Your media. One beautiful home.">
<meta property="og:description" content="A fast, private media home for movies, series, music and live TV. Self-hosted for free, with hosted plans coming soon from $10/month.">
<meta property="og:url" content="https://odissey.app/">
<meta property="og:image" content="https://odissey.app/social-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Odissey orbit brand mark">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Odissey — Your media. One beautiful home.">
<meta name="twitter:description" content="A fast, private media home for movies, series, music and live TV. Self-hosted for free, with hosted plans coming soon from $10/month.">
<meta name="twitter:image" content="https://odissey.app/social-card.png">

<title>Odissey — Your media. One beautiful home.</title>`;

const previewHead = `<meta name="robots" content="noindex">
<meta name="theme-color" content="#05070c">
<title>Preview 01 · Aurora — Odissey</title>
<link rel="icon" href="assets/favicon.svg">`;

const switcherStyles = `/* ── Variant switcher ───────────────────────────────────────── */

.switcher {
  position: fixed; left: 16px; bottom: 16px; z-index: 100;
  display: flex; align-items: center; gap: 2px; padding: 5px;
  border-radius: 100px; font-size: .72rem; font-weight: 640;
}
.switcher span { padding: 0 9px; color: var(--soft); letter-spacing: .08em; text-transform: uppercase; font-size: .62rem; font-weight: 800; }
.switcher a { padding: 6px 12px; border-radius: 100px; color: var(--muted); text-decoration: none; transition: color .25s, background .25s; }
.switcher a:hover { color: var(--text); background: color-mix(in oklch, #fff 8%, transparent); }
.switcher a.on { color: var(--accent-ink); background: var(--accent); }

`;

const switcherMarkup = `<nav class="switcher glass" aria-label="Concept switcher">
  <span>Concepts</span>
  <a href="index.html">⌂</a>
  <a class="on" href="aurora.html">01 Aurora</a>
  <a href="editorial.html">02 Editorial</a>
  <a href="terminal.html">03 Terminal</a>
</nav>

`;

let productionHtml = readFileSync(prototypePath, "utf8");

productionHtml = replaceOnce(
  productionHtml,
  previewHead,
  productionHead,
  "preview metadata",
);
productionHtml = replaceOnce(
  productionHtml,
  `/* ═══════════════════════════════════════════════════════════════
   ODISSEY · CONCEPT 01 — "AURORA"
   Ethereal glass, living gradients, scroll-driven choreography.
   Zero JavaScript. Modern CSS only:
   @property · scroll()/view() timelines · backdrop-filter ·
   color-mix · mask-composite · :has() · sticky stacking ·
   ::details-content · text-wrap: balance
   ═══════════════════════════════════════════════════════════════ */

`,
  "",
  "prototype header comment",
);
productionHtml = replaceOnce(
  productionHtml,
  switcherStyles,
  "",
  "prototype switcher styles",
);
productionHtml = replaceOnce(
  productionHtml,
  switcherMarkup,
  "",
  "prototype switcher navigation",
);
productionHtml = replaceOnce(
  productionHtml,
  "  .switcher span { display: none; }\n",
  "",
  "mobile switcher rule",
);
productionHtml = replaceOnce(
  productionHtml,
  "© 2026 Odissey · Concept preview — not the production site",
  "© 2026 Odissey",
  "preview footer label",
);
productionHtml = productionHtml
  .replaceAll('url("assets/odissey-orbit.webp")', 'url("/odissey-orbit.webp")')
  .replaceAll('src="assets/favicon.svg"', 'src="/favicon.svg"')
  .replace(
    "html { scroll-behavior: smooth; }",
    "html { scroll-behavior: smooth; overflow-x: clip; }",
  );
---

<Fragment set:html={productionHtml} />
