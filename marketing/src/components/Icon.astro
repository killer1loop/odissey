---
interface Props {
  name:
    | "play"
    | "library"
    | "live"
    | "music"
    | "users"
    | "shield"
    | "server"
    | "sparkles"
    | "captions"
    | "arrow"
    | "check"
    | "cloud"
    | "remote"
    | "home"
    | "film"
    | "star"
    | "history"
    | "search";
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  {
    name === "play" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="m10 8 6 4-6 4Z" />
      </>
    )
  }
  {
    name === "library" && (
      <>
        <rect x="3" y="4" width="5" height="16" rx="1" />
        <rect x="10" y="4" width="5" height="16" rx="1" />
        <path d="m17.5 5 3.5 14M17 18.5l4-.9" />
      </>
    )
  }
  {
    name === "live" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m9 10 5 3-5 3ZM8 2l4 3 4-3" />
      </>
    )
  }
  {
    name === "music" && (
      <>
        <path d="M9 18V6l10-2v12" />
        <ellipse cx="6.5" cy="18" rx="2.5" ry="2" />
        <ellipse cx="16.5" cy="16" rx="2.5" ry="2" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <circle cx="9" cy="8" r="3" />
        <path d="M3.5 19c.4-4 2.2-6 5.5-6s5.1 2 5.5 6M15 5.5a3 3 0 0 1 0 5.8M16.5 14c2.5.4 3.8 2 4 5" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M12 3 20 6v5c0 5-3 8.5-8 10-5-1.5-8-5-8-10V6Z" />
        <path d="m8.5 12 2.2 2.2 4.8-5" />
      </>
    )
  }
  {
    name === "server" && (
      <>
        <rect x="3" y="4" width="18" height="6" rx="1.5" />
        <rect x="3" y="14" width="18" height="6" rx="1.5" />
        <path d="M7 7h.01M7 17h.01M11 7h7M11 17h7" />
      </>
    )
  }
  {
    name === "sparkles" && (
      <>
        <path d="m12 3 1.2 3.8L17 8l-3.8 1.2L12 13l-1.2-3.8L7 8l3.8-1.2ZM5.5 14l.8 2.2 2.2.8-2.2.8L5.5 20l-.8-2.2-2.2-.8 2.2-.8ZM18.5 14l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8Z" />
      </>
    )
  }
  {
    name === "captions" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M10 10.5a2.5 2.5 0 1 0 0 3M18 10.5a2.5 2.5 0 1 0 0 3" />
      </>
    )
  }
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14M14 7l5 5-5 5" />
      </>
    )
  }
  {
    name === "check" && (
      <>
        <path d="m5 12 4 4L19 6" />
      </>
    )
  }
  {
    name === "cloud" && (
      <>
        <path d="M7.5 18H18a3 3 0 0 0 .6-5.9A6 6 0 0 0 7.2 9.7 4.2 4.2 0 0 0 7.5 18Z" />
      </>
    )
  }
  {
    name === "remote" && (
      <>
        <rect x="7" y="2.5" width="10" height="19" rx="3" />
        <circle cx="12" cy="7" r="1.5" />
        <path d="M10 12h4M12 10v4M10 17h.01M14 17h.01" />
      </>
    )
  }
  {
    name === "home" && (
      <>
        <path d="M3 10.5 12 3l9 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5Z" />
        <path d="M9 21v-6h6v6" />
      </>
    )
  }
  {
    name === "film" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m9 10 5 3-5 3ZM7 5V3M12 5V3M17 5V3" />
      </>
    )
  }
  {
    name === "star" && (
      <>
        <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z" />
      </>
    )
  }
  {
    name === "history" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.5 2M5.5 5.5 3 8V3" />
      </>
    )
  }
  {
    name === "search" && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m15.5 15.5 4.5 4.5" />
      </>
    )
  }
</svg>
