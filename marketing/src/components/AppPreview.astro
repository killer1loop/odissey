---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";

const navItems = [
  { label: "Home", icon: "home" as const, active: true },
  { label: "Movies", icon: "film" as const },
  { label: "TV Shows", icon: "live" as const },
  { label: "Music", icon: "music" as const },
  { label: "Live TV", icon: "live" as const },
];

const sources = [
  {
    label: "Live TV",
    copy: "Guide, groups and favorites",
    badge: "Live",
    icon: "live" as const,
    tone: "amber",
  },
  {
    label: "Movies & TV",
    copy: "All connected video libraries",
    badge: "Direct + HLS",
    icon: "play" as const,
    tone: "cyan",
  },
  {
    label: "Music",
    copy: "Albums and tracks",
    badge: "Lossless",
    icon: "music" as const,
    tone: "violet",
  },
  {
    label: "Favorites",
    copy: "Your saved live channels",
    badge: "Personal",
    icon: "star" as const,
    tone: "green",
  },
];

const continueWatching = [
  {
    title: "The Crossing",
    meta: "S02 E06 · 31 min left",
    progress: "68%",
    tone: "crossing",
  },
  {
    title: "Quiet Current",
    meta: "2025 · Drama",
    progress: "34%",
    tone: "current",
  },
  {
    title: "Afterlight",
    meta: "S01 E04 · 18 min left",
    progress: "82%",
    tone: "afterlight",
  },
  {
    title: "Open Field",
    meta: "2026 · Documentary",
    progress: "12%",
    tone: "field",
  },
];
---

<div
  class="product-frame"
  data-product-frame
  data-tilt
  aria-label="Realistic preview of the Odissey home dashboard"
>
  <div class="product-frame__chrome" aria-hidden="true">
    <div class="traffic-lights">
      <span></span><span></span><span></span>
    </div>
    <div class="frame-address">
      <span class="frame-lock"></span>
      odissey.home
    </div>
    <div class="frame-status">Connected</div>
  </div>

  <div class="product-app">
    <aside class="product-sidebar" aria-hidden="true">
      <div class="product-brand"><Brand compact={true} /></div>
      <div class="product-nav">
        <p>Browse</p>
        {
          navItems.map((item) => (
            <div class:list={["product-nav__item", item.active && "is-active"]}>
              <Icon name={item.icon} size={15} />
              <span>{item.label}</span>
            </div>
          ))
        }
        <p>Your media</p>
        <div class="product-nav__item">
          <Icon name="star" size={15} />
          <span>Favorites</span>
        </div>
        <div class="product-nav__item">
          <Icon name="history" size={15} />
          <span>History</span>
        </div>
      </div>
      <div class="product-account">
        <span>AS</span>
        <div>
          <strong>Alex</strong>
          <small>Viewer</small>
        </div>
        <i>↗</i>
      </div>
    </aside>

    <div class="product-workspace">
      <div class="product-topbar">
        <div class="product-search">
          <Icon name="search" size={14} />
          <span>Search live channels</span>
        </div>
        <div class="product-quicklinks">
          <span>Movies</span>
          <span>TV Shows</span>
          <span>Live TV</span>
        </div>
      </div>

      <div class="product-dashboard">
        <div class="dashboard-welcome">
          <div>
            <span class="dashboard-eyebrow">Home</span>
            <h3>Welcome back, Alex</h3>
          </div>
          <p>Continue watching or open a connected library.</p>
        </div>

        <section class="dashboard-source-section" aria-label="Connected libraries">
          <div class="dashboard-section-title">
            <strong>Browse</strong>
            <span>4 sources online</span>
          </div>
          <div class="dashboard-sources">
            {
              sources.map((source) => (
                <article class:list={["dashboard-source", `dashboard-source--${source.tone}`]}>
                  <div class="dashboard-source__art">
                    <span class="source-grid"></span>
                    <Icon name={source.icon} size={24} />
                    <small>{source.badge}</small>
                  </div>
                  <strong>{source.label}</strong>
                  <span>{source.copy}</span>
                </article>
              ))
            }
          </div>
        </section>

        <section class="dashboard-continue" aria-label="Continue watching">
          <div class="dashboard-section-title">
            <strong>Continue watching</strong>
            <span>View history</span>
          </div>
          <div class="continue-row">
            {
              continueWatching.map((item) => (
                <article class="continue-card">
                  <div class:list={["continue-card__art", `continue-card__art--${item.tone}`]}>
                    <span class="poster-horizon"></span>
                    <i style={`--progress:${item.progress}`}></i>
                    <button type="button" tabindex="-1" aria-hidden="true">
                      <Icon name="play" size={16} />
                    </button>
                  </div>
                  <strong>{item.title}</strong>
                  <span>{item.meta}</span>
                </article>
              ))
            }
          </div>
        </section>

        <div class="dashboard-runtime">
          <div>
            <span class="runtime-dot"></span>
            <strong>Ready to stream</strong>
            <small>FFmpeg online · queues clear</small>
          </div>
          <div class="runtime-pills">
            <span>Direct play</span>
            <span>1080p</span>
            <span>Captions</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
