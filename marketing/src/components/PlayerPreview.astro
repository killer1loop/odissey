---
import Icon from "./Icon.astro";
---

<div
  class="cinema-frame"
  data-player-frame
  data-tilt
  aria-label="Fictional but product-accurate Odissey video player"
>
  <div class="cinema-ambient" aria-hidden="true"></div>
  <div class="cinema-topbar">
    <div class="cinema-channel">
      <span>O</span>
      <div>
        <small>Now playing</small>
        <strong>Low Orbit</strong>
      </div>
    </div>
    <div class="cinema-title">
      <strong>The Crossing</strong>
      <span>Episode 6 · 2026</span>
    </div>
    <div class="cinema-live-state">
      <span class="runtime-dot"></span>
      Healthy
    </div>
  </div>

  <div class="cinema-screen">
    <div class="cinema-sky" aria-hidden="true">
      <span class="cinema-planet"></span>
      <span class="cinema-arc"></span>
      <span class="cinema-star cinema-star--one"></span>
      <span class="cinema-star cinema-star--two"></span>
      <span class="cinema-star cinema-star--three"></span>
      <span class="cinema-star cinema-star--four"></span>
    </div>
    <button type="button" tabindex="-1" aria-hidden="true" class="cinema-play">
      <Icon name="play" size={32} />
    </button>
    <span class="cinema-caption">We only see the signal when the sky goes quiet.</span>
  </div>

  <div class="cinema-controls" aria-hidden="true">
    <div class="cinema-timeline"><span></span><i></i></div>
    <div class="cinema-control-row">
      <div class="cinema-control-icons">
        <Icon name="play" size={17} />
        <span class="volume-glyph"></span>
        <Icon name="captions" size={17} />
      </div>
      <span class="cinema-time">42:18 / 1:47:02</span>
      <div class="cinema-metrics">
        <span>1920×1080</span>
        <span>8.4 Mbps</span>
        <span>50 FPS</span>
        <span>H.264</span>
      </div>
    </div>
  </div>
</div>
