APP_URL=http://localhost:8000
SESSION_SECURE_COOKIE=false
ODISSEY_SETUP_TOKEN=
ODISSEY_RELEASE=replace-with-the-release-tag-or-commit

# The fixed worker pool and FFmpeg are sized for a beta host with at least
# four CPU cores and 12 GiB RAM. The tmpfs counts against the container's
# memory limit, so lower these only after workload testing.
ODISSEY_CONTAINER_CPUS=4.0
ODISSEY_CONTAINER_MEMORY=8g
ODISSEY_CONTAINER_PIDS=512
ODISSEY_TRANSCODE_TMPFS_SIZE=4g
