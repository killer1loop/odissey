	admin off
	auto_https off
	frankenphp
}

# HTTP access logging is intentionally disabled. Native playback grants are
# short-lived bearer credentials carried in /api/v1/playback/assets/* paths.
{$SERVER_NAME} {
	root * /app/public
	encode zstd br gzip

	php_server {
		try_files {path} index.php
	}
}
